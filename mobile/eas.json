{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lifeline-api-9ox2.onrender.com",
        "EXPO_PUBLIC_CONSOLE_URL": "https://nidhi-gujarat.vercel.app/geda"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lifeline-api-9ox2.onrender.com",
        "EXPO_PUBLIC_CONSOLE_URL": "https://nidhi-gujarat.vercel.app/geda"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
