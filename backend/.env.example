# SQLite works out of the box; point at Postgres for production.
DATABASE_URL=sqlite:///./lifeline.db
# DATABASE_URL=postgresql+psycopg://lifeline:lifeline@localhost:5432/lifeline

# Supabase: the app uses the transaction pooler (port 6543). URL-encode special characters in the password (@ -> %40).
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session pooler (same host, port 5432), IPv4-friendly, for migrations:
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Use a long random string in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-in-production

CORS_ORIGINS=["http://localhost:3000"]

# Proof photos: "local" (UPLOAD_DIR) or "supabase" (a private Storage bucket; the service key stays on the server).
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=proofs

# Optional AI bill scanning and proof-photo pre-screening. Groq is used if both are set; without either, bills are read on-device.
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=

# Set to false to run fully offline (PVGIS solar data and Open-Meteo weather fall back to defaults).
ENABLE_EXTERNAL_APIS=true
